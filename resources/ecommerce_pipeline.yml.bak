
resources:
  jobs:
    ecommerce_pipeline:
      name: ecommerce_lakehouse_${bundle.target}
      max_concurrent_runs: 1
      schedule:
        quartz_cron_expression: "0 0 6 * * ?"
        timezone_id: "Europe/Amsterdam"
        pause_status: UNPAUSED

      - task_key: bronze_ingestion
  max_retries: 1
  spark_python_task:
    python_file: ../notebooks/development/bronze_ingestion.py
    source: WORKSPACE
    parameters:
      - "--catalog"
      - ${var.catalog}
      - "--environment"
      - ${bundle.target}
  environment_key: default

        - task_key: silver_transformations
          max_retries: 1
          depends_on:
            - task_key: bronze_ingestion
          spark_python_task:
            python_file: ../notebooks/development/silver_transformations.py
            source: WORKSPACE
            parameters:
              - "--catalog"
              - ${var.catalog}
              - "--environment"
              - ${bundle.target}
          environment_key: default

        - task_key: gold_transformations
          max_retries: 1
          depends_on:
            - task_key: silver_transformations
          spark_python_task:
            python_file: ../notebooks/development/gold_transformations.py
            source: WORKSPACE
            parameters:
              - "--catalog"
              - ${var.catalog}
              - "--environment"
              - ${bundle.target}
          environment_key: default

      environments:
        - environment_key: default
          spec:
            environment_version: "2"
            dependencies: []
